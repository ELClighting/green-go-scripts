
    var toggle = 0

    function cuemode_off() // turn off cue and cancel cuemode control
        channel.cue[1] = 1
        channel.cue[2] = 1
        channel.cue[3] = 1
        channel.cue[4] = 1
        cancel ui.button[ui.bpx.1]
        cancel ui.button[ui.bpx.2]
        cancel ui.button[ui.bpx.3]
        cancel ui.button[ui.bpx.4]
        cancel ui.encoder[ui.bpx.encoder.left]
        cancel ui.encoder[ui.bpx.encoder.right]
    end

    function cuemode_on() // turn off talk on transition
        channel.talk[1] = 0
        channel.talk[2] = 0
        channel.talk[3] = 0
        channel.talk[4] = 0
        event ui.button[ui.bpx.1] // if button pressed toggle idle to attention, attention or wait to go, go to idle
            channel.cue[1] = ui.button[ui.bpx.1] == ui.button.pressed ? channel.cue[1] == 0 ? 2 : channel.cue[1] == 2 ? 4 : channel.cue[1] == 3 ? 4 : channel.cue[1] == 4 ? 0 : "" : ""
        end
        event ui.button[ui.bpx.2]
            channel.cue[2] = ui.button[ui.bpx.2] == ui.button.pressed ? channel.cue[2] == 0 ? 2 : channel.cue[2] == 2 ? 4 : channel.cue[2] == 3 ? 4 : channel.cue[2] == 4 ? 0 : "" : ""
        end
        event ui.button[ui.bpx.3]
            channel.cue[3] = ui.button[ui.bpx.3] == ui.button.pressed ? channel.cue[3] == 0 ? 2 : channel.cue[3] == 2 ? 4 : channel.cue[3] == 3 ? 4 : channel.cue[3] == 4 ? 0 : "" : ""
        end
        event ui.button[ui.bpx.4] // if button pressed and any cue not idle toggle between any idle to any go
            channel.cue[4] = ui.button[ui.bpx.4] == ui.button.pressed ? channel.cue[4] == 0 ? 2 : channel.cue[4] == 2 ? 4 : channel.cue[4] == 3 ? 4 : channel.cue[4] == 4 ? 0 : "" : ""
        end
        event ui.encoder[ui.bpx.encoder.left] // clear cue mode on encoder useage
            toggle = 0
        end
        event ui.encoder[ui.bpx.encoder.right]
            toggle = 0
        end
    end

    event ui.draw // toggle between cuemode and normal operation
        if ui.button[ui.bpx.1] & ui.button[ui.bpx.2] & ui.button[ui.bpx.3] & ui.button[ui.bpx.4] == ui.button.pressed
            timer[1] = 100
        end
        if toggle == 0
            cuemode_off()
        else
            cuemode_on()
        end
        ui.draw.text("'") // load indicator
    end

    event timer[1] // transition pad
        toggle = toggle == 0 ? 1 : 0
    end 

// CP20260520 WBPX & WBPXSP 5.2.2