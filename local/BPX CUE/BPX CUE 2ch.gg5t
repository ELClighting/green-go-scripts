
    var toggle = 0

    function cuemode_off() // turn off cue and cancel cuemode control
        channel.cue[1] = 1
        channel.cue[2] = 1
        cancel ui.button[ui.bpx.3]
        cancel ui.button[ui.bpx.4]
    end

    function cuemode_on() // turn off talk on transition
        channel.talk[1] = 0
        channel.talk[2] = 0
        event ui.button[ui.bpx.3] // if button pressed toggle idle to attention, attention or wait to go, go to idle
            channel.cue[1] = ui.button[ui.bpx.3] == ui.button.pressed ? channel.cue[1] == 0 ? 2 : channel.cue[1] == 2 ? 4 : channel.cue[1] == 3 ? 4 : channel.cue[1] == 4 ? 0 : "" : ""
        end
        event ui.button[ui.bpx.4]
            channel.cue[2] = ui.button[ui.bpx.4] == ui.button.pressed ? channel.cue[2] == 0 ? 2 : channel.cue[2] == 2 ? 4 : channel.cue[2] == 3 ? 4 : channel.cue[2] == 4 ? 0 : "" : ""
        end
        ui.color = ui.color.green // mode indication
        ui.draw.rectangle(92, 3,4,26)
        ui.draw.rectangle(92,35,4,26)
    end

    event ui.draw // toggle between cuemode and normal operation
        if ui.button[ui.bpx.1] & ui.button[ui.bpx.2] == ui.button.pressed
            timer[1] = 100
        end
        if toggle == 0
            cuemode_off()
        else
            cuemode_on()
        end
        ui.draw.text("'") // load indicator
    end

    event timer[1] // transition pad
        toggle = toggle == 0 ? 1 : 0
    end 

